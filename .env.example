# ==============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Option 1: MongoDB Atlas (Cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/inventory_order_api?retryWrites=true&w=majority
# Option 2: Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_order_api

# JSON Web Token (JWT) Configuration (HS256)
# Generate a 256-bit secure secret (e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_hs256_256bit_secret_key_here_e.g._64_hex_characters
JWT_EXPIRES_IN=7d
